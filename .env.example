# Copy to .env for local overrides. All optional — sensible defaults are baked in.
DEBUG=true
SECRET_KEY=dev-insecure-key-change-me
# Leave unset to use the local SQLite db. To use Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/edit
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
